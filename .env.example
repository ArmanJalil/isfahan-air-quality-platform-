# ---- Copy this file to .env and fill in real values. NEVER commit .env ----

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=isfahan_aqm
PG_USER=postgres
PG_PASSWORD=change_me

# Upstream Isfahan air-quality API (obtain your own credentials)
AQ_API_BASE_URL=https://aqm.isfahan.ir/Service
AQ_API_USERNAME=your_api_username
AQ_API_PASSWORD=your_api_password
AQ_API_STATE_ID=6

# App
APP_TZ=Asia/Tehran
AIRPORT_STATION_ID=361
